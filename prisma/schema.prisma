// DARKO Prisma schema — Phase 1
// Dev: SQLite. Prod: switch provider to "postgresql" + DATABASE_URL=Supabase connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Users & Auth ============

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  roomsOwned  Room[]       @relation("OwnedRooms")
  memberships RoomMember[]
  messages    Message[]
  reports     Report[]     @relation("ReporterReports")
  bans        Ban[]        @relation("BannedUserBans")
  preferences UserPreferences?

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreferences {
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultTheme     String  @default("midnight-lounge")
  defaultMicId     String?
  defaultCamId     String?
  muteOnJoin       Boolean @default(true)
  camOffOnJoin     Boolean @default(true)
  lowBandwidthMode Boolean @default(false)
  reducedMotion    Boolean @default(false)
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ============ Rooms ============

model Room {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String?
  ownerId         String
  owner           User        @relation("OwnedRooms", fields: [ownerId], references: [id])
  isPublic        Boolean     @default(false)
  passwordHash    String?
  maxParticipants Int         @default(8)
  theme           String      @default("midnight-lounge")
  currentMode     String      @default("WATCH")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastActivity    DateTime    @default(now())
  expiresAt       DateTime?

  members   RoomMember[]
  settings  RoomSettings?
  messages  Message[]
  playlist  PlaylistItem[]
  reports   Report[]      @relation("ReportedRoomReports")
  bans      Ban[]         @relation("RoomBans")

  @@index([ownerId])
  @@index([isPublic, lastActivity])
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  lastSeen DateTime @default(now())
  isOnline Boolean  @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, isOnline])
}

model RoomSettings {
  roomId              String  @id
  room                Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allowGuests         Boolean @default(true)
  allowChat           Boolean @default(true)
  allowVoice          Boolean @default(true)
  allowVideo          Boolean @default(true)
  allowScreenShare    Boolean @default(true)
  allowFileShare      Boolean @default(true)
  allowGames          Boolean @default(true)
  allowWhiteboard     Boolean @default(true)
  mediaControl        String  @default("HOST_ONLY")
  invitePermission    String  @default("MEMBERS")
  kickPermission      String  @default("MODERATORS")
  chatRateLimitPerMin Int     @default(30)
}

// ============ Chat ============

model Message {
  id         String           @id @default(cuid())
  roomId     String
  userId     String
  content    String
  replyToId  String?
  isDeleted  Boolean          @default(false)
  deletedBy  String?
  createdAt  DateTime         @default(now())

  room       Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])
  replyTo    Message?         @relation("MessageReply", fields: [replyToId], references: [id])
  replies    Message[]        @relation("MessageReply")
  reactions  MessageReaction[]

  @@index([roomId, createdAt])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// ============ Playlist ============

model PlaylistItem {
  id        String   @id @default(cuid())
  roomId    String
  addedBy   String
  source    String
  url       String
  title     String?
  duration  Int?
  position  Int
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}

// ============ Moderation ============

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  reporter        User         @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUserId  String?
  reportedRoomId  String?
  reportedRoom    Room?        @relation("ReportedRoomReports", fields: [reportedRoomId], references: [id])
  reason          String
  details         String?
  status          String       @default("OPEN")
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?
  resolvedById    String?

  @@index([status, createdAt])
}

model Ban {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("BannedUserBans", fields: [userId], references: [id])
  roomId    String?
  room      Room?     @relation("RoomBans", fields: [roomId], references: [id])
  reason    String
  bannedBy  String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([roomId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
